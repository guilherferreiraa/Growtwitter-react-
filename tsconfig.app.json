{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "jsx": "react-jsx"
  },
  "include": ["src/**/*"]
}