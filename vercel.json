{
  "version": 2,
  "builds": [
    { "src": "src/server.ts", "use": "@vercel/node" },
    { "src": "package.json", "use": "@vercel/static-build" }
  ],
"routes": [
  {
    "src": "/auth/(.*)",
    "dest": "src/server.ts"
  },
  {
    "src": "/follow/(.*)",
    "dest": "src/server.ts"
  },
  {
    "src": "/(.*)",
    "dest": "/index.html"
  }
]
}